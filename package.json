{
  "name": "ninebot-g3-control",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "python3 -m http.server 8080 --directory dist",
    "build:vendor": "esbuild build/vendor-entry.mjs --bundle --format=esm --platform=browser --outfile=dist/vendor/bluetooth-le.js",
    "cap:add": "cap add android",
    "cap:sync": "npm run build:vendor && cap sync",
    "cap:copy": "npm run build:vendor && cap copy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.0.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "esbuild": "^0.24.2"
  }
}
